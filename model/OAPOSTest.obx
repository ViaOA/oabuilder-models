          <UseUITab>false</UseUITab>
          <Code><![CDATA[public String getCalcCityStateZip() {
    String csz = OAStr.concat(getCity(), getState(), ", ");
    csz = OAStr.concat(csz, getZip(), " ");
    return csz;
}]]></Code>
