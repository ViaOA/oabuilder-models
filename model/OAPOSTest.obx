        <Filter id="g32719a4a-7d0a-46fa-bb20-4fd23e513ef8">
          <Name>lastDay</Name>
          <UpperName>LastDay</UpperName>
          <DisplayName>Last Day</DisplayName>
          <Seq>1</Seq>
          <AddToTableFilters>false</AddToTableFilters>
          <UseRenderer>false</UseRenderer>
          <RefreshDaily>false</RefreshDaily>
          <Code><![CDATA[public boolean isUsed(AppUserLogin appUserLogin) {
    OADateTime created = appUserLogin.getCreated();
    if (created == null) return false;
    OADateTime d1 = created.addDays(1);
    OADateTime d2 = new OADateTime();
    if (d1.before(d2)) return false;
    return true;
}
]]></Code>
