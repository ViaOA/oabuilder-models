          <Type>Currency</Type>
          <Name>totalCheckAmount</Name>
          <Flag>false</Flag>
          <UpperName>TotalCheckAmount</UpperName>
          <DisplayName>Total Check Amount</DisplayName>
          <Transient>false</Transient>
          <Html>false</Html>
          <HtmlTemplate>false</HtmlTemplate>
          <HtmlOutput>false</HtmlOutput>
          <Error>false</Error>
          <Inactive>false</Inactive>
          <Report>false</Report>
          <UseUITab>false</UseUITab>
          <Code><![CDATA[public double getTotalCheckAmount() {
    double d = 0;
    for (InvoicePaymentCheck ipc : getInvoicePaymentChecks()) {
        InvoicePayment ip = ipc.getInvoicePayment();
        if (ip != null) {
            d = OAConv.add(d, ip.getAmount(), 2);
        }
    }
    return d;
}]]></Code>
