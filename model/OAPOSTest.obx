          <UseUITab>false</UseUITab>
          <Code><![CDATA[public double getTotalCheckAmount() {
    double d = 0.0;
    for (InvoicePaymentCheck invoicePaymentCheck : this.getInvoicePaymentChecks()) {
        InvoicePayment ip = invoicePaymentCheck.getInvoicePayment();
        if (ip != null) d = OAConv.add(d, ip.getAmount(), 2);
    }
    return d;
}]]></Code>
