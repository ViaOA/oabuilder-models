          <Code><![CDATA[public String getDisplayName() {
    String displayName = "";
    loginId = this.getLoginId();
    if (loginId != null) {
        displayName = loginId;
    }
    if (displayName.length() > 0) displayName += " ";
    displayName += " (";
    String fullName = this.getFullName();
    if (fullName != null) {
        displayName += fullName;
    }
    displayName += ")";
    return displayName;
}
]]></Code>
