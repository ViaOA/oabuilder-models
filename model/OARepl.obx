    <Change id="g4528">
      <UpdateCode><![CDATA[-- LINK a replicationMaster has many replicationClients Added
ALTER TABLE ReplicationClient ADD COLUMN ReplicationMasterId int;
ALTER TABLE ReplicationClient ADD CONSTRAINT FkReplicationClientReplicationMaster FOREIGN KEY (ReplicationMasterId) REFERENCES ReplicationMaster (Id);
CREATE INDEX ReplicationClientReplicationMaster ON ReplicationClient (ReplicationMasterId);]]></UpdateCode>
      <Object idref="g4520"/>
      <Type>21</Type>
      <DisplayName>LINK a replicationMaster has many replicationClients Added</DisplayName>
      <model idref="g4458"/>
    </Change>
