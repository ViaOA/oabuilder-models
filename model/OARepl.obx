  <Changes total="4">
    <Change id="g4501">
      <UpdateCode><![CDATA[-- OBJECT ReplicationMaster Added
-- Table ReplicationMaster For ReplicationMaster
CREATE TABLE ReplicationMaster(
    Id int NOT NULL,
    Created DATETIME DEFAULT CURRENT_TIMESTAMP,
    Seq long
);
ALTER TABLE ReplicationMaster Add Constraint PkReplicationMaster PRIMARY KEY (Id);
 ]]></UpdateCode>
      <Object idref="g4493"/>
      <Type>0</Type>
      <DisplayName>OBJECT ReplicationMaster Added</DisplayName>
