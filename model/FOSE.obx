          <IconName>false</IconName>
          <GridColumnName>Calc Timezone</GridColumnName>
          <GridColumnLength>15</GridColumnLength>
          <Url>false</Url>
          <Email>false</Email>
          <Phone>false</Phone>
          <ZipCode>false</ZipCode>
          <ImageName>false</ImageName>
          <Xml>false</Xml>
          <Pdf>false</Pdf>
          <NoLineWrap>false</NoLineWrap>
          <MaxDisplayLength>70</MaxDisplayLength>
          <Directory>false</Directory>
          <MaxLength>70</MaxLength>
          <DecimalPlaces>0</DecimalPlaces>
