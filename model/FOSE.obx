          <MinLength>0</MinLength>
          <Type>String</Type>
          <File>false</File>
          <Code><![CDATA[public String getDisplay() {
    String display = "";
    int storeNumber = this.getStoreNumber();
    display = "(" + String.format("%05d", storeNumber) + ")";

    Location loc = getLocation();
    if (loc != null) {
        String name = loc.getBusinessName();
        display = OAString.concat(display, name, " ");
    }
    return display;
}]]></Code>
