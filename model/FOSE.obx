          <Code><![CDATA[public OADateTime getLastImport() {
    OADateTime dtLast = null;
    Hub<SquareImport> hubSquareImports = this.getSquareImports();
    for (SquareImport squareImport : hubSquareImports) {
        if (squareImport.getNextStep() != SquareImport.NEXTSTEP_done || squareImport.getItemCount() == 0) continue;
        OADateTime dt = squareImport.getCreated();
        if (dtLast == null || dtLast.before(dt)) dtLast = dt;
    }
    return dtLast;
}]]></Code>
