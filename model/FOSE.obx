          <Signature>void runNextStep</Signature>
          <Code><![CDATA[public void runNextStep() throws Exception {
    // use this to run on server
    if (isRemoteAvailable()) {
        remote();
        return;
    }
    // custom code
    SquareStoreSalesImportDelegate.runNextStep(this);
}
