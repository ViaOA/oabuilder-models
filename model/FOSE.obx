          <ObjectCallbackCode><![CDATA[public void nameCallback(final OAObjectCallback callback) {
    if (callback == null) return;
    switch (callback.getType()) {
    case GetToolTip:
        callback.ack();
        
        String tt = getName();
        tt += "<br>";
        
        int cnt = 0;
        for (Store store : getStores()) {
            if (cnt++ > 0) tt += ", ";
            tt += store.getCalcStoreNumber();
            if (store.getDyehard()) tt += " (dyehard)";
        }
        callback.setToolTip(tt);
        break;
    }
}
]]></ObjectCallbackCode>
