          <MinLength>0</MinLength>
          <Type>int</Type>
          <File>false</File>
          <Code><![CDATA[public int getCalcHashCode() {
    StringBuilder sb = new StringBuilder();

    sb.append(OAStr.notNull(getName()));
    sb.append('|');
    sb.append(OAStr.notNull(getSku()));
    sb.append('|');
    sb.append(OAStr.notNull(getUpc()));
    sb.append('|');
    sb.append(OAConv.toString(getPrice(), "#.##"));
    sb.append('|');

    for (Barcode barcode : getBarcodes()) {
        sb.append(OAStr.notNull(barcode.getBarcode()));
        sb.append('|');
    }

    Item item = getItem();
    if (item != null) {
        sb.append(OAStr.notNull(item.getName()));
        sb.append('|');

        for (TaxRate tr : item.getTaxRates()) {
            sb.append(OAConv.toString(tr.getTaxPercent(), "#.####"));
            sb.append('|');
        }

        for (Store store : item.getStores()) {
            Location loc = store.getLocation();
            if (loc != null) {
                sb.append(loc.getReferenceId());
                sb.append('|');

                for (Location locx : loc.getOffsiteLocations()) {
                    sb.append(locx.getReferenceId());
                    sb.append('|');
                }
            }
        }
        ItemCategory ic = item.getItemCategory();
        if (ic != null) {
            sb.append(ic.getName());
            sb.append('|');
        }
    }

    String s = sb.toString();
    int hc = s.hashCode();

    return hc;
}]]></Code>
