          <MinLength>0</MinLength>
          <Type>DateTime</Type>
          <File>false</File>
          <Code><![CDATA[public OADateTime getCalcSalesCsvLoaded() {
    Store store = getStore();
    School school = store.getSchool();
    OAFinder<DailyTestStore, DailySchoolProcess> finder = new OAFinder(DailyTestStorePP.dailyTest().dailyProcess().dailySchoolProcesses().pp);
    finder.addEqualFilter(DailySchoolProcess.P_School, school);
    DailySchoolProcess dsp = finder.findFirst(this);
    if (dsp == null) return null;
    
    SquareStoreSalesImport sssi = dsp.getSquareSalesImport().getSquareStoreSalesImports().find(SquareStoreSalesImport.P_Store, store);
    if (sssi == null) return null;
    OADateTime dt = sssi.getFileLoaded();
    return dt;
}
]]></Code>
