      <methods total="1">
        <Method id="g6470">
          <CompletedMessage>a duplicate Tax Rate has been created.</CompletedMessage>
          <ConfirmationMessage>OK to create a duplicate of this Tax Rate</ConfirmationMessage>
          <IsCommand>true</IsCommand>
          <IsRemote>true</IsRemote>
          <ShowProcessing>true</ShowProcessing>
          <AllowCancel>false</AllowCancel>
          <SupportsMultipleAtOnce>false</SupportsMultipleAtOnce>
          <IsStatic>false</IsStatic>
          <Signature>void duplicate</Signature>
          <Code><![CDATA[public void duplicate() {
    // use this to run on server
    if (isRemoteAvailable()) {
        remote();
        return;
    }
    // custom code
    TaxRate trNew = new TaxRate();
    this.copyInto(trNew);
    trNew.setName(trNew.getName() + "  DUPLICATE");
    trNew.setSchool(this.getSchool());
    this.getSchool().getTaxRates().add(trNew);
    
    TaxRateDuplicate dup = new TaxRateDuplicate();
    dup.setTaxRate(this);
    dup.setNewTaxRate(trNew);
}]]></Code>
          <Hide>false</Hide>
          <Created>2023-09-15</Created>
          <Transient>false</Transient>
          <Html>false</Html>
          <EnabledCompareValue>false</EnabledCompareValue>
          <VisibleCompareValue>false</VisibleCompareValue>
          <ContextEnabledCompareValue>false</ContextEnabledCompareValue>
          <ContextVisibleCompareValue>false</ContextVisibleCompareValue>
          <HtmlTemplate>false</HtmlTemplate>
          <HtmlOutput>false</HtmlOutput>
          <Inactive>false</Inactive>
          <Report>false</Report>
          <UseUITab>false</UseUITab>
          <Description>create a duplicate TaxRate</Description>
          <Help><![CDATA[This will create a duplicate of the existing TaxRate, and add it to all 
      of Items that use this TaxRate.<br>Each of the items will have the new 
      TaxRate added. &#160;It needs to recalculate the Product.lastHashCode. 
    </p>
    The user can then rename.<br><br>For the Square Interface update:<br>Add 
    the new TaxRate<br>use the bulk Item add TaxRate<br><br>]]></Help>
          <Flag>false</Flag>
          <UpperName>Duplicate</UpperName>
          <Name>duplicate</Name>
          <Error>false</Error>
          <DisplayName>Duplicate</DisplayName>
          <objectDef idref="g6457"/>
        </Method>
      </methods>
