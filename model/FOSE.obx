          <TableCode><![CDATA[public void customizeRenderer(JLabel lbl, DailyProcessThread dailyProcessThread, boolean isSelected, boolean hasFocus, int row, boolean wasChanged, boolean wasMouseOver) {
    if (dailyProcessThread == null) return;
    lbl.setBackground(Color.cyan);
}
