        <EditTableProperty id="g6362">
          <TableCode><![CDATA[public void customizeRenderer(JLabel lbl, Store store, boolean isSelected, boolean hasFocus, int row, boolean wasChanged, boolean wasMouseOver) {
    if (store == null) return;
    if (store.getCalcOnHold()) {
        String s = store.getOnHoldReason();
        if (OAStr.isEmpty(s)) s = "On hold";
        lbl.setText(s);
    }
}
public String getToolTipText(Store store, int row, String defaultValue) {
    return defaultValue;
}]]></TableCode>
