      <methods total="1">
        <Method id="g6256">
          <ConfirmationMessage>OK to convert this Store to an Offsite Location under another Store</ConfirmationMessage>
          <IsCommand>true</IsCommand>
          <IsRemote>true</IsRemote>
          <ShowProcessing>true</ShowProcessing>
          <AllowCancel>false</AllowCancel>
          <SupportsMultipleAtOnce>false</SupportsMultipleAtOnce>
          <IsStatic>false</IsStatic>
          <Signature>void convertToOffsiteLocation</Signature>
          <Code><![CDATA[public boolean convertToOffsiteLocation(final StoreConvertToOffsiteLocationMethod data) {
     if (data == null) return false;
     // custom code here

     Location loc = getLocation();
     if (loc == null) return false;
     if (loc.getOffsiteLocations().size() > 0) return false;
     
     final Store newStore = data.getNewStore();
     if (newStore == null) return false;
     
     newStore.getLocation().getOffsiteLocations().add(loc);
     
     this.delete();
     return true;
 }]]></Code>
          <ObjectCallbackCode><![CDATA[public void convertToOffsiteLocationCallback(final OAObjectCallback callback) {
    if (callback == null) return;
    switch (callback.getType()) {
    case AllowEnabled:
        callback.ack();
        Location loc = getLocation();
        if (loc == null) {
            callback.setResponse("This store does not have a location.");
            callback.setAllowed(false); 
        }
        else if (loc.getOffsiteLocations().size() > 0) {
            callback.setResponse("This store has Offsite locations, it cant be converted to an offsite location.");
            callback.setAllowed(false); 
        }
        else {
            callback.setAllowed(true); 
        }
        break;
    }
}]]></ObjectCallbackCode>
