              <Code><![CDATA[public boolean getDataIsLoaded() {
    if  (getRanClearedData() != null) return false; 
    int nextStep = this.getNextStep();
    return (nextStep > NEXTSTEP_squareImport);
}
public boolean isDataIsLoaded() {
    return getDataIsLoaded();
