          <File>false</File>
          <Code><![CDATA[public String getFullName() {
    String fullName = "";
    String firstName = this.getFirstName();
    fullName = OAString.concat(fullName, firstName, " ");

    String lastName = this.getLastName();
    fullName = OAString.concat(fullName, lastName, " ");

    return fullName;
}
]]></Code>
