          <Code><![CDATA[public OADateTime getLastUpdate() {
    OADateTime dtLast = null;
    Hub<SquareUpdate> hubSquareUpdates = this.getSquareUpdates();
    for (SquareUpdate squareUpdate : hubSquareUpdates) {
        if (squareUpdate.getNextStep() != SquareUpdate.NEXTSTEP_done) continue;
        OADateTime dt = squareUpdate.getCreated();
        if (dtLast == null || dtLast.before(dt)) dtLast = dt;
    }
    return dtLast;
}]]></Code>
