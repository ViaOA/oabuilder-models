    <ObjectDef id="g4652">
      <CustomCode></CustomCode>
      <ObjectControllerCode><![CDATA[for (PosPaymentType ppt : ModelDelegate.getPosPaymentTypes()) {
    switch (ppt.getTypeEnum()) {
        case Visa:
        case Debit:
        case Mastercard:
        case Discover:
        case AMEX:
        case Diners:
            ppt.setUsesCardNumber(true);
            break;
        default:
            ppt.setUsesCardNumber(false);
            break;
    }
}
]]></ObjectControllerCode>
