          <Type>boolean</Type>
          <File>false</File>
          <Code><![CDATA[public boolean getCalcValid() {
    double calcTotal = this.getCalcTotal();
    double payTotal = 0.0d;
    for (PosPayment posPayment : getPosPayments()) {
        double d = posPayment.getAmount();
        payTotal = OAConv.add(payTotal, d, 2);
    }
    if (!OAConv.isEqual(payTotal, calcTotal, 2)) {
        if (!OAConv.isEqual(-payTotal, calcTotal, 2)) {
            return false;
        }
    }
    for (PosItem posItem : getPosItems()) {
        if (!posItem.getTaxExempt() && OAStr.isEmpty(posItem.getTaxCode())) {
            return false;
        }
    }
    return true;
}]]></Code>
