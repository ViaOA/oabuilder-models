          <Type>String</Type>
          <File>false</File>
          <Code><![CDATA[public int getCalcHashCode() {
    final StringBuilder sb = new StringBuilder();
    sb.append(OAStr.notNull(getFirstName()));
    sb.append(OAStr.notNull(getLastName()));
    sb.append(OAStr.notNull(getEmail()));
    sb.append(OAStr.notNull(getPhoneNumber()));
    sb.append(this.getInactiveDate());
    String s = sb.toString();
    int hc = s.hashCode();
    return hc;        
}]]></Code>
