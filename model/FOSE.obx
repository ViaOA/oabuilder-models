          <Code><![CDATA[public String getDisabledReason() {
    String msg = null;
    if (this.getCancelled() != null) msg = OAStr.append(msg, "Process Cancelled", ", ");
    School school = this.getSchool();
    if (school != null) {
        String s = school.getDisabledReason();
        if (s != null) msg = OAStr.append(msg, s, ", ");
    }
    return msg;
}
]]></Code>
