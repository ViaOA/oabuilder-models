          <Type>String</Type>
          <File>false</File>
          <Code><![CDATA[public String getCalcStatus() {
    if (getNextStep() == NEXTSTEP_done) return getNextStepDisplay();
    DailySchoolProcess dsp = getDailySchoolProcess();
    if (dsp != null) {
        if (dsp.getDisabledReason() != null) return dsp.getDisabledReason(); 
    }
    else if (getCorePosInterface() != null) {
        School school = getCorePosInterface().getSchool();
        if (school != null && school.getDisabledReason() != null) return school.getDisabledReason(); 
    }
    for (CorePosImportFile cpif : getCorePosImportFiles()) {
        if (cpif.getProcessErrors().size() > 0) return "Has Errors";
    }
    return getNextStepDisplay();
}]]></Code>
          <ObjectCallbackCode><![CDATA[public void calcStatusCallback(final OAObjectCallback callback) {
    if (callback == null) return;
    switch (callback.getType()) {
    case GetToolTip:
        callback.ack();
        String tt = "";
        int cnt = 1;
        for (NextStep ns : NextStep.values()) {
            if (cnt > 1) tt += "<br>";
            String s = String.format("Step %d: %s", cnt++, ns.display);
            if (ns == getNextStepEnum()) s = "<b>" + s + "</b>";
            tt += s;
        }
        callback.setToolTip(tt);
        break;
    case RenderLabel:
        callback.ack();
        JLabel lbl = callback.getLabel();

        if (getNextStep() == NEXTSTEP_done) {
            lbl.setBackground(java.awt.Color.green);
            break;
        }
        
        final DailySchoolProcess dsp = getDailySchoolProcess();
        final School school = getCorePosInterface().getSchool();
        java.awt.Color color = null;
        
        if (dsp != null) {
            if (dsp.getDisabledReason() != null) color = java.awt.Color.lightGray; 
        }
        else {
            if (school.getDisabledReason() != null) {
                if (school.getDisabledReason() != null) color = java.awt.Color.lightGray; 
            }
        }
        
        if (color == null) {
            for (CorePosImportFile cpif : getCorePosImportFiles()) {
                if (cpif.getProcessErrors().size() > 0) {
                    color = java.awt.Color.red;
                    lbl.setForeground(java.awt.Color.white);
                    break;
                }
            }
            if (color == null && dsp != null) {
                if (dsp.getDailyProcessThread() != null) {
                    color = java.awt.Color.cyan;
                }
                else if (dsp.getLastProcessed() != null) {
                    color = java.awt.Color.yellow;
                }
            }
        }
        if (color != null) lbl.setBackground(color);
        
        // String txt = getCalcStatus();
        // lbl.setText(txt);
        break;
    }
}]]></ObjectCallbackCode>
