          <File>false</File>
          <Code><![CDATA[public boolean getValidTaxRates() {
    boolean validTaxRates = true;
    Hub<TaxRate> hubTaxRates = this.getTaxRates();
    if (hubTaxRates.size() > 1) {
        for (TaxRate tr : hubTaxRates) {
            if (tr.getLocations().size() > 1) {
                validTaxRates = false;
                break;
            }
        }
    }
    return validTaxRates;
}]]></Code>
