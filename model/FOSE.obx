          <Type>0</Type>
          <Code><![CDATA[public DailyTestStore getCalcDailyTestStore() {
    // Custom code here to get CalcDailyTestStore
    Store store = getStore();
    if (store == null) return null;
    OAFinder<FoseTestStore, DailyTestStore> finder = new OAFinder<>(FoseTestStorePP.foseTestDate().dailyTest().dailyTestStores().pp);
    finder.addEqualFilter(DailyTestStore.P_Store, store);
    DailyTestStore dts = finder.findFirst(this);
    return dts;
}
]]></Code>
