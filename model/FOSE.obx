          <Signature>void setAll</Signature>
          <Code><![CDATA[public void setAll(final SchoolSetAllMethod data) throws Exception {
    if (data == null) return;
    // custom code
    SchoolDelegate.setAll(this, data);
}
public static void setAll(final Hub<School> hub,final SchoolSetAllMethod data) throws Exception {
    if (hub == null) return;
    for (School school : hub) {
        school.setAll(data);
    }
}
]]></Code>
