        <CalcProperty id="g2443">
          <IsForHub>false</IsForHub>
          <IncludeRefreshOption>false</IncludeRefreshOption>
          <IconName>false</IconName>
          <GridColumnName>Calc Upc</GridColumnName>
          <GridColumnLength>20</GridColumnLength>
          <Url>false</Url>
          <Email>false</Email>
          <Phone>false</Phone>
          <ZipCode>false</ZipCode>
          <ImageName>false</ImageName>
          <Xml>false</Xml>
          <Pdf>false</Pdf>
          <NoLineWrap>false</NoLineWrap>
          <MaxDisplayLength>50</MaxDisplayLength>
          <Directory>false</Directory>
          <MaxLength>0</MaxLength>
          <DecimalPlaces>0</DecimalPlaces>
          <Json>false</Json>
          <Unique>false</Unique>
          <DisplayLength>20</DisplayLength>
          <MinLength>0</MinLength>
          <Type>String</Type>
          <File>false</File>
          <Code><![CDATA[public String getCalcUpc() {
    String sku = getSku();
    String upc = this.getUpc();
    String newUpc = upc;
    
    if (sku != null) {
        if (upc == null) {
            upc = sku;
        }
        String s1 = OAStr.removeLeading(sku, '0');
        String s2 = OAStr.removeLeading(upc, '0');
        if (s1.equals(s2)) {
            // should be len=8
            if (s2.length() < 8) s2 = OAStr.padStart(s2, 8-s2.length(), '0');
            return s2;
        }
    }

    if (upc == null) return null;
    
    newUpc = OAStr.removeLeading(upc, '0');
    int x = 12 - upc.length();
    if (x > 0) newUpc = OAStr.padStart(newUpc, x, '0');
    return newUpc;
}]]></Code>
