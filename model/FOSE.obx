          <Type>boolean</Type>
          <File>false</File>
          <Code><![CDATA[public boolean getCalcOnHold() {
    OADate beg = this.getOnHoldBegin();
    OADate end = this.getOnHoldEnd();
    if (beg == null && end == null) return false;
    if (beg != null && beg.after(new OADate())) return false;
    return (end == null || end.compare(new OADate()) >= 0); 
}
public boolean isCalcOnHold() {
    return getCalcOnHold();
}]]></Code>
