          <Type>String</Type>
          <File>false</File>
          <Code><![CDATA[public String getDisabledReason() {
    String msg = null;
    boolean b = true;
    for (Store store : getStores()) {
        if (store.getDisabled() == null) b = false;
    }
    if (b) msg = OAStr.append(msg, "All Stores Disabled", ", ");

    for (Store store : getStores()) {
        if (store.getCalcOnHold() && store.getDisabled() == null) {
            msg = OAStr.append(msg, "Store On Hold", ", ");
            break;
        }
    }
    return msg;
}
]]></Code>
