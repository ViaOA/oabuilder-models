          <Type>DateTime</Type>
          <File>false</File>
          <ObjectCallbackCode><![CDATA[public void precheckedCallback(final OAObjectCallback callback) {
    if (callback == null) return;
    switch (callback.getType()) {
    case GetToolTip:
        callback.ack();
        String tt;
        
        String s = getDisabledReason();
        if (s != null) tt = s;
        else if (getPrechecked() != null) tt = "passed";
        else if (getNextStep() < NEXTSTEP_precheck) tt = "not checked";
        else if (getLastProcessed() == null) tt = "not checked";
        else {
            tt = "Failed";
            // find failures
            tt += "<br>Square Import: " + (getSquareImport().getPrechecked() == null ? "failed" : "passed"); 
            tt += "<br>Vertex Import: " + (getVertexImport().getPrechecked() == null ? "failed" : "passed"); 
            tt += "<br>MMS Tax Import: " + (getMMSTaxImport().getPrechecked() == null ? "failed" : "passed"); 
            tt += "<br>MMS Item Import: " + (getMMSItemImport().getPrechecked() == null ? "failed" : "passed"); 
            tt += "<br>CorePOS CSV Import: " + (getCorePosImport().getPrechecked() == null ? "failed" : "passed"); 
            tt += "<br>Square Update: " + (getSquareUpdate().getPrechecked() == null ? "failed" : "passed"); 
        }
        callback.setToolTip(tt);
        break;
    case RenderLabel:
        callback.ack();
        JLabel lbl = callback.getLabel();
        if (getPrechecked() != null) {
            lbl.setText("passed");
            lbl.setBackground(java.awt.Color.green);
        }
        else if (getDisabledReason() != null) {
            lbl.setText(getDisabledReason());
            lbl.setBackground(java.awt.Color.lightGray);
        }
        else if (getNextStep() < NEXTSTEP_precheck) {
            lbl.setText("not checked");
        }
        else if (getLastProcessed() == null) {
            lbl.setText("not checked");
        }
        else {
            lbl.setText("failed");
            lbl.setBackground(java.awt.Color.yellow);
        }
        break;
    }
}]]></ObjectCallbackCode>
