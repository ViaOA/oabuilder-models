          <Signature>void process</Signature>
          <Code><![CDATA[public void runNextStep() throws Exception {
    // use this to run on server
    if (isRemoteAvailable()) {
        remote();
        return;
    }
    // custom code
    MMSTaxImportFileDelegate.runNextStep(this);
}
]]></Code>
