          <ObjectCallbackCode><![CDATA[public void calcStatusCallback(final OAObjectCallback callback) {
    if (callback == null) return;
    switch (callback.getType()) {
    case GetToolTip:
        callback.ack();
        String tt = "";

        String s = getDisabledReason();
        if (s != null) tt = s;

        int cnt = 1;
        for (NextStep ns : NextStep.values()) {
            if (tt.length() > 0) tt += "<br>";
            s = String.format("Step %d: %s", cnt++, ns.display);
            if (ns == getNextStepEnum()) s = "<b>" + s + "</b>";
            tt += s;
        }

        if (getNextStep() != NEXTSTEP_done) {
            if (!getAllowSquareUpdate()) tt += "<br>* Daily School Process 'allow square update' is not checked";
            if (!getSchool().getAllowSquareChanges()) tt += "<br>* School 'allow square changes' is not checked";
        }            
        callback.setToolTip(tt);
        
        break;
    case RenderLabel:
        callback.ack();
        JLabel lbl = callback.getLabel();
        if (getNextStep() == NEXTSTEP_done) lbl.setBackground(java.awt.Color.green);
        else if (getDisabledReason() != null) lbl.setBackground(java.awt.Color.lightGray);
        else if (getDailyProcessThread() != null) lbl.setBackground(java.awt.Color.cyan);
        else if (getLastProcessed() != null) lbl.setBackground(java.awt.Color.yellow);
        break;
    }
}]]></ObjectCallbackCode>
