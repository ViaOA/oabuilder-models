      <CalcProperties total="3">
        <CalcProperty id="g6541">
          <IsForHub>false</IsForHub>
          <IncludeRefreshOption>false</IncludeRefreshOption>
          <IconName>false</IconName>
          <GridColumnName>Calc Hash Code</GridColumnName>
          <GridColumnLength>10</GridColumnLength>
          <Url>false</Url>
          <Email>false</Email>
          <Phone>false</Phone>
          <ZipCode>false</ZipCode>
          <ImageName>false</ImageName>
          <Xml>false</Xml>
          <Pdf>false</Pdf>
          <NoLineWrap>false</NoLineWrap>
          <MaxDisplayLength>20</MaxDisplayLength>
          <Directory>false</Directory>
          <MaxLength>20</MaxLength>
          <DecimalPlaces>0</DecimalPlaces>
          <Json>false</Json>
          <Unique>false</Unique>
          <DisplayLength>6</DisplayLength>
          <MinLength>0</MinLength>
          <Type>int</Type>
          <File>false</File>
          <Code><![CDATA[public int getCalcHashCode() {
    StringBuilder sb = new StringBuilder();
    sb.append(OAStr.notNull(getName()));
    sb.append('|');

    sb.append(OAStr.notNull(getCode()));
    sb.append('|');
    
    sb.append(OAConv.toString(getTaxPercent(), "#.####"));
    sb.append('|');
    
    for (Location loc : getLocations()) {
        sb.append(OAStr.notNull(loc.getReferenceId()));
        sb.append('|');
    }
    
    String s = sb.toString();
    int hc = s.hashCode();
    return hc;
}]]></Code>
