          <Type>DateTime</Type>
          <File>false</File>
          <Code><![CDATA[public OADateTime getLastProcessed() {
    OADateTime dt = null;
    for (CorePosImport corePosImport : getCorePosImports()) {
        OADateTime dtx = corePosImport.getProcessedStoreFiles();
        if (dtx != null) {
            if (dt == null || dtx.after(dt)) dt = dtx;
        }
    }
    return dt;
}]]></Code>
