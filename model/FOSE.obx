      <CalcProperties total="2">
        <CalcProperty id="g4597">
          <IsForHub>false</IsForHub>
          <IncludeRefreshOption>false</IncludeRefreshOption>
          <IconName>false</IconName>
          <GridColumnName>Total</GridColumnName>
          <GridColumnLength>8</GridColumnLength>
          <Url>false</Url>
          <Email>false</Email>
          <Phone>false</Phone>
          <ZipCode>false</ZipCode>
          <ImageName>false</ImageName>
          <Xml>false</Xml>
          <Pdf>false</Pdf>
          <NoLineWrap>false</NoLineWrap>
          <MaxDisplayLength>12</MaxDisplayLength>
          <Directory>false</Directory>
          <MaxLength>20</MaxLength>
          <DecimalPlaces>2</DecimalPlaces>
          <Json>false</Json>
          <Unique>false</Unique>
          <DisplayLength>9</DisplayLength>
          <MinLength>0</MinLength>
          <Type>Currency</Type>
          <File>false</File>
          <Code><![CDATA[public double getCalcTotal() {
    double calcTotal = 0;
    for (PosItem posItem : hubPosItems) {
        int quantity = posItem.getQuantity();
        double price = posItem.getPrice();
        
        double d = OAConv.multiply(quantity, price, 2);
        d = OAConv.subtract(d, posItem.getDiscount());
        d = OAConv.add(d, posItem.getTax());
        if (posItem.getItemReturn()) d *= -1.0;
        
        calcTotal = OAConv.add(calcTotal, d);
    }
    return calcTotal;
}
]]></Code>
