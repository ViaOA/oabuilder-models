              <Code><![CDATA[public boolean getCalcLoadFileCommandEnabled() {
    String jsonFile = this.getJsonFile();
    if (OAStr.isEmpty(jsonFile)) return false;
    
    OADateTime fileLoaded = this.getFileLoaded();
    return fileLoaded == null;
}
public boolean isCalcLoadFileCommandEnabled() {
    return getCalcLoadFileCommandEnabled();
}]]></Code>
