          <Code><![CDATA[public boolean getCalcHasChanged() {
    boolean hasChanged;
    int lastHashCode = this.getLastHashCode();

    int calcHashCode = this.getCalcHashCode();

    return lastHashCode != calcHashCode;
}]]></Code>
