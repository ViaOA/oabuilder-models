          <Code><![CDATA[public boolean isUsed(CorePosImportLine cpil) {
    if (cpil.getNewSchoolItem()) return true;
    if (cpil.getNewStoreItem()) return true;
    if (cpil.getItemChanged()) return true;
    if (cpil.getNewCategory()) return true;
    if (cpil.getNewSchoolTaxRate()) return true;
    return false;
}]]></Code>
