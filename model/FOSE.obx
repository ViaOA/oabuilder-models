          <Code><![CDATA[public void runNextStep() throws Exception {
    // use this to run on server
    if (isRemoteAvailable()) {
        remote();
        return;
    }
    // custom code
    SquareUpdateDelegate.runNextStep(this);
}
]]></Code>
          <ObjectCallbackCode><![CDATA[public void runNextStepCallback(final OAObjectCallback callback) {
    if (callback == null) return;
    switch (callback.getType()) {
    case SetConfirmForCommand:
        callback.ack();
        callback.setAllowed(true); 
        if (nextStep < NEXTSTEP_reviewSelection || nextStep >= NEXTSTEP_done) {
            callback.setConfirmMessage(null);
        }
        else {
            callback.setConfirmMessage("Ok to run next Step:" + getNextStepDisplay());
            callback.setConfirmTitle("Square Update");
        }
        break;
    case AllowEnabled:
        callback.ack();
        if (nextStep > NEXTSTEP_reviewSelection && nextStep < NEXTSTEP_done) {
            School sch = getSquareInterface().getSchool();
            callback.setAllowed(sch.getAllowSquareChanges()); 
            if (!sch.getAllowSquareChanges()) {
                callback.setResponse("Must setup School to 'allow square changes'");
                callback.setToolTip(callback.getResponse());
            }
        }
        else if (nextStep > NEXTSTEP_done) {
            callback.setAllowed(false);
        }
        else callback.setAllowed(true); 
        break;
    }
}
]]></ObjectCallbackCode>
