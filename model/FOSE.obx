          <Type>String</Type>
          <File>false</File>
          <Code><![CDATA[public String getLocationTimezone() {
    Location location = this.getLocation();
    if (location == null) return "";
    String ltz = location.getTimezone();
    OATimeZone.TZ tz = OATimeZone.getOATimeZone(ltz);
    if (tz == null) return "";
    return tz.getDisplay();
}]]></Code>
