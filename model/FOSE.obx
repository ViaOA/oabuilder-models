          <Code><![CDATA[public boolean getCalcAllowSquareUpdate() {
    if (!getAllowSquareUpdate()) return false;
    School school = this.getSchool();
    if (school == null || !school.getAllowSquareChanges()) return false;
    return true;
}
]]></Code>
          <ObjectCallbackCode><![CDATA[public void calcAllowSquareUpdateCallback(final OAObjectCallback callback) {
    if (callback == null) return;
    switch (callback.getType()) {
    case GetToolTip:
        callback.ack();
        String tt = "";
        if (getCalcAllowSquareUpdate()) {
            tt = "Square update is enabled";
        }
        else {
            tt = "Square update is not enabled";
            if (!getAllowSquareUpdate()) tt += "<br>'Allow Square Update' is not checked";
            School school = this.getSchool();
            if (school == null || !school.getAllowSquareChanges()) {
                tt += "<br>The School's 'Allow Square Changes' is not checked";
            }
        }
        callback.setToolTip(tt);
        break;
    }
}]]></ObjectCallbackCode>
