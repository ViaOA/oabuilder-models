          <IsStatic>false</IsStatic>
          <Signature>void removeImportLines</Signature>
          <Code><![CDATA[public void removeImportLines() throws Exception {
    // use this to run on server
    if (isRemoteAvailable()) {
        remote();
        return;
    }
    // custom code
    getCorePosImportLines().deleteAll();
    setFileLoaded(null);
}
]]></Code>
