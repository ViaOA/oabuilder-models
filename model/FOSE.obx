      <methods total="1">
        <Method id="g1703">
          <ConfirmationMessage>OK to remove unselected Admin Emps from list?</ConfirmationMessage>
          <IsCommand>true</IsCommand>
          <IsRemote>false</IsRemote>
          <ShowProcessing>true</ShowProcessing>
          <AllowCancel>false</AllowCancel>
          <SupportsMultipleAtOnce>true</SupportsMultipleAtOnce>
          <IsStatic>false</IsStatic>
          <Signature>void removeOthers</Signature>
          <Code><![CDATA[public void removeOthers() throws Exception {
    // custom code
}
public static void removeOthers(final Hub<AdminEmployee> hub) {
    if (hub == null) return;
    for (AdminEmployee ae : ModelDelegate.getAdminEmployees()) {
        if (!hub.contains(ae)) ModelDelegate.getAdminEmployees().remove(ae);
    }
}]]></Code>
