        <CalcProperty id="g3697">
          <IsForHub>false</IsForHub>
          <IncludeRefreshOption>false</IncludeRefreshOption>
          <IconName>false</IconName>
          <GridColumnName>Calc Hash Code</GridColumnName>
          <GridColumnLength>14</GridColumnLength>
          <Url>false</Url>
          <Email>false</Email>
          <Phone>false</Phone>
          <ZipCode>false</ZipCode>
          <ImageName>false</ImageName>
          <Xml>false</Xml>
          <Pdf>false</Pdf>
          <NoLineWrap>false</NoLineWrap>
          <MaxDisplayLength>20</MaxDisplayLength>
          <Directory>false</Directory>
          <MaxLength>20</MaxLength>
          <DecimalPlaces>0</DecimalPlaces>
          <Json>false</Json>
          <Unique>false</Unique>
          <DisplayLength>6</DisplayLength>
          <MinLength>0</MinLength>
          <Type>int</Type>
          <File>false</File>
          <Code><![CDATA[public int getCalcHashCode() {
    StringBuilder sb = new StringBuilder();

    sb.append(OAStr.notNull(getName()));
    sb.append('|');
    
    sb.append(OAStr.notNull(getAddress()));
    sb.append('|');

    sb.append(OAStr.notNull(getAddress2()));
    sb.append('|');
    
    sb.append(OAStr.notNull(getCity()));
    sb.append('|');

    sb.append(OAStr.notNull(getState()));
    sb.append('|');
    
    sb.append(OAStr.notNull(getZip()));
    sb.append('|');

    OATimeZone.TZ tz = OATimeZone.getOATimeZone(getTimezone());
    if (tz != null) sb.append(OAStr.notNull(tz.id));
    sb.append('|');

    /* not needed, taxRate keeps track of location changes, and will be updated
    for (TaxRate tr : getTaxRates()) {
        sb.append(OAConv.toString(tr.getTaxPercent(), "#.##"));
        sb.append('|');
    }
    */
    
    String s = sb.toString();
    int hc = s.hashCode();
    return hc;
}]]></Code>
