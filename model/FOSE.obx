          <Code><![CDATA[public boolean getAllStoresDisabled() {
    for (Store store : getStores()) {
        if (store.getDisabled() == null) return false; 
    }
    return true;
}
public boolean isAllStoresDisabled() {
    return getAllStoresDisabled();
