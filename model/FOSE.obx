              <Code><![CDATA[public boolean getCanCreateJsonFile() {
    if (OAStr.isEmpty(this.getJsonFile())) return false;
    return (this.getNextStep() >= NextStep.reviewSelection.ordinal());
}
public boolean isCanCreateJsonFile() {
    return getCanCreateJsonFile();
