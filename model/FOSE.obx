          <GridColumnLength>20</GridColumnLength>
          <Url>false</Url>
          <Email>false</Email>
          <Phone>false</Phone>
          <ZipCode>false</ZipCode>
          <ImageName>false</ImageName>
          <Xml>false</Xml>
          <Pdf>false</Pdf>
          <NoLineWrap>false</NoLineWrap>
          <MaxDisplayLength>22</MaxDisplayLength>
          <Directory>false</Directory>
          <MaxLength>40</MaxLength>
          <DecimalPlaces>0</DecimalPlaces>
          <Json>false</Json>
          <Unique>false</Unique>
          <DisplayLength>15</DisplayLength>
          <MinLength>0</MinLength>
          <Type>DateTime</Type>
          <File>false</File>
          <Code><![CDATA[public OADateTime getCalcItemCsvLoaded() {
    Store store = getStore();
    School school = store.getSchool();
    OAFinder<DailyTestStore, DailySchoolProcess> finder = new OAFinder(DailyTestStorePP.dailyTest().dailyProcess().dailySchoolProcesses().pp);
    finder.addEqualFilter(DailySchoolProcess.P_School, school);
    DailySchoolProcess dsp = finder.findFirst(this);
    if (dsp == null) return null;
    CorePosImportFile cpif = dsp.getCorePosImport().getCorePosImportFiles().find(CorePosImportFile.P_Store, store);
    if (cpif == null) return null;
    OADateTime dt = cpif.getFileLoaded();
    return dt;
}
]]></Code>
