          <Code><![CDATA[public boolean getAllowTesting() {
    boolean b = this.getAdmin();
    if (b) {
        AppServer as = com.fose.delegate.ModelDelegate.getAppServer();
        b = as != null && com.fose.delegate.ModelDelegate.getAppServer().getTestOnly();
    }
    return b;
}
public boolean isAllowTesting() {
    return getAllowTesting();
}]]></Code>
