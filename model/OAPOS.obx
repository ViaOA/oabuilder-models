          <Code><![CDATA[public double getCalcTotalCash() {
    double calcTotalCash = 0;
    double otherCash = this.getOtherCash();
//qqqqqqqqqqqqqq    
        Hub<RegisterDailyCashDenominationPackage> hubRegisterDailyCashDenominationPackages = this.getRegisterDailyCashDenominationPackages();
        for (RegisterDailyCashDenominationPackage registerDailyCashDenominationPackage : hubRegisterDailyCashDenominationPackages) {
            calcTotalCash = registerDailyCashDenominationPackage.getCalcTotalCash();
        }
    
    return calcTotalCash;
}]]></Code>
