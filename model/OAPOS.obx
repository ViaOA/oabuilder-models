              <Code><![CDATA[public boolean getUsesRestricted() {
    int itemRuleType = this.getItemRuleTypeInt();
    int locationRuleType = this.getLocationRuleTypeInt();
    boolean b = locationRuleType != LOCATIONRULETYPE_NOT_USED;
    return b;
}]]></Code>
