  <Changes total="3">
    <Change id="g9278">
      <UpdateCode><![CDATA[-- OBJECT Demo Added
-- Table Demo For Demo
CREATE TABLE Demo(
    Id int NOT NULL,
    Created DATETIME DEFAULT CURRENT_TIMESTAMP,
    Started DATETIME,
    Stopped DATETIME,
    Paused DATETIME
);
ALTER TABLE Demo Add Constraint PkDemo PRIMARY KEY (Id);
 ]]></UpdateCode>
      <Object idref="g6171"/>
      <Type>0</Type>
      <DisplayName>OBJECT Demo Added</DisplayName>
      <model idref="g4717"/>
    </Change>
    <Change id="g9279">
      <UpdateCode><![CDATA[-- OBJECT DemoNode Added
-- Table DemoNode For DemoNode
CREATE TABLE DemoNode(
    Id int NOT NULL,
    Created DATETIME DEFAULT CURRENT_TIMESTAMP,
    Type int,
    Name VARCHAR(0),
    Started DATETIME,
    Paused DATETIME,
    Stopped DATETIME,
    Disconnect DATETIME,
    ShowOutput bit
);
ALTER TABLE DemoNode Add Constraint PkDemoNode PRIMARY KEY (Id);
 ]]></UpdateCode>
      <Object idref="g6199"/>
      <Type>0</Type>
      <DisplayName>OBJECT DemoNode Added</DisplayName>
      <model idref="g4717"/>
    </Change>
    <Change id="g9280">
      <UpdateCode><![CDATA[-- LINK a demo has many demoNodes Added
ALTER TABLE DemoNode ADD COLUMN DemoId int;
ALTER TABLE DemoNode ADD CONSTRAINT FkDemoNodeDemo FOREIGN KEY (DemoId) REFERENCES Demo (Id);
CREATE INDEX DemoNodeDemo ON DemoNode (DemoId);]]></UpdateCode>
      <Object idref="g5496"/>
      <Type>21</Type>
      <DisplayName>LINK a demo owns many demoNodes Added</DisplayName>
      <model idref="g4717"/>
    </Change>
  </Changes>
