          <TableCode><![CDATA[public void customizeRenderer(JLabel lbl, ItemRestriction itemRestriction, boolean isSelected, boolean hasFocus, int row, boolean wasChanged, boolean wasMouseOver) {
    if (itemRestriction == null) return;
    String searchValue = itemRestriction.getRuleSearchValue();
    // use OAJfcUtil static methods ...  ex: useColorBorder, useDitto, alignLeft, useColorIcon, etc
    if (OAString.isEmpty(searchValue)) OAJfcUtil.useRedBorder(lbl);
}
public String getToolTipText(ItemRestriction itemRestriction, int row, String defaultValue) {
    if (itemRestriction == null) return defaultValue;
    // String searchValue = itemRestriction.getRuleSearchValue();
    return "<html>"+OAString.notNull(itemRestriction.getRuleSearchValueDescription());
}]]></TableCode>
