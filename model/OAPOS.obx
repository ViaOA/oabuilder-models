          <Json>false</Json>
          <Code><![CDATA[public String getCalcDisplay() {
    OADate date = this.getDate();
    if (date == null) return "no date set";
    String s = date.toString();
    s += " - " + this.getTeamMembers().getSize() + " Employee scheduled";
    return s;
}]]></Code>
