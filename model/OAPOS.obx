    else lbl.setBackground(Color.magenta);
}
public String getToolTipText(ItemRestriction itemRestriction, int row, String defaultValue) {
    if (itemRestriction != null && !itemRestriction.getUsesRestricted()) {
        return "<html>Item rule does not use Restricted";
    }
    return defaultValue;
}]]></TableCode>
