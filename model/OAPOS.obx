    if (!itemRestriction.getUsesCounty()) lbl.setBackground(Color.lightGray);
    else lbl.setBackground(Color.cyan);
}
public String getToolTipText(ItemRestriction itemRestriction, int row, String defaultValue) {
    if (itemRestriction != null && !itemRestriction.getUsesCounty()) {
        return "<html>Location rule does not use County";
    }
    return defaultValue;
}]]></TableCode>
