          <Code><![CDATA[public Hub<InvoicePaymentCheck> getCalcInvoicePaymentChecks() {
    if (hubCalcInvoicePaymentChecks == null) {
        hubCalcInvoicePaymentChecks = (Hub<InvoicePaymentCheck>) getHub(P_CalcInvoicePaymentChecks);
    }
    // custom
    StoreSafeLedgerEntryDelegate.calcInvoicePaymentChecks(this, hubCalcInvoicePaymentChecks);
    return hubCalcInvoicePaymentChecks;
}]]></Code>
