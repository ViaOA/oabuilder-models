          <Code><![CDATA[public int getType() {
    return type;
}
public void setType(int newValue) {
    int old = type;
    fireBeforePropertyChange(P_Type, old, newValue);
    this.type = newValue;
    firePropertyChange(P_Type, old, this.type);
    // custom
    TillLedgerEntryDelegate.afterSettingType(this);
}]]></Code>
